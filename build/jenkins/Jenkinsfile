/*
These will be added to jenkinsfile as parameters and its default values once parameters are finalized.
Jenkins job parameters needed:
1. RELEASE (String) - Map to internal release Ex: 2021.2.0
2. GITPROJECTURL (String) - Git repo URL
3. GITBRANCH (String) - Git branch to build
4. DEV (Boolean) - DEV or PROD build
5. BUILD_XLNX (Boolean) - Whether the Build is run in Xilinx or non-xilinx env
6. AUTH_TOKEN (Credentials) - Username and password/access token for artifactory publishes
7. ARTIFACTORY_URL (String) - Artifactory to publish packages
8. ARTIFACTORY_REPO (String) - Artifactory repo name to publish packages
9. EMAIL_RECIPIENTS(String) - List of Email recipients
*/

//Check if a PR Build or Not
boolean prBuild = env.ghprbPullLink != null;
env.AUTH_TOKEN = params.AUTH_TOKEN
env.DEBREPOKEY = params.DEBREPOKEY != null ? params.DEBREPOKEY : 'xrt-ipu-deb-prod-local'
env.RPMREPOKEY = params.RPMREPOKEY != null ? params.RPMREPOKEY : 'xrt-ipu-rpm-prod-local'
env.ARTIFACTORYSERVER = params.ARTIFACTORYSERVER != null ? params.ARTIFACTORYSERVER : 'https://xcoartifactory/artifactory'
env.FILEPATHNFS = params.DEV ? "/proj/xbuilds/XRT-IPU-DEV/" : "/proj/xbuilds/XRT-IPU/"

//Parameters for Jenkins Job
properties([
  parameters([
    booleanParam(defaultValue: false, description: 'DEV Run', name: 'DEV'),
    booleanParam(defaultValue: true, description: 'Whether the Build is run in Xilinx or non-xilinx env', name: 'BUILD_XLNX'),
    string(defaultValue: '2021.2', name: 'RELEASE', description: 'RELEASE value e.g 2021.2'),
    string(defaultValue: 'master', name: 'GITBRANCH', description: 'Git Branch e.g master'),
    string(defaultValue: 'xrt-ipu-rpm-prod-local', name: 'RPMREPOKEY', description: 'RPM repo Key'),
    string(defaultValue: 'xrt-ipu-deb-prod-local', name: 'DEBREPOKEY', description: 'Deb repo Key'),
    credentials(name: 'AUTH_TOKEN', description: 'A user to build with', credentialType: 'com.cloudbees.plugins.credentials.impl.UsernamePasswordCredentialsImpl', defaultValue: 'xbuild-xcoartifactory-accesstoken'),
    string(defaultValue: 'https://xcoartifactory/artifactory', name: 'ARTIFACTORYSERVER', description: 'Artifactory Server URK'),
    string(defaultValue: 'kbhardwa@xilinx.com; abalasa@xilinx.com; jliang@xilinx.com', name: 'EMAIL_RECIPIENTS', description: 'Email Receipients'),
    string(defaultValue: 'master', name: 'GITBRANCH', description: 'Git Branch e.g master'),
    string(defaultValue: 'https://gitenterprise.xilinx.com/XRT/XRT-IPU.git', name: 'GITPROJECTURL', description: 'XRT Git roject URL'),
  ])
])

/**
 * sync the git WS.
 * @param prBuild if true then it will get the PR to the sandbox, otherwise the commit
 * 
 */

def syncWS(boolean prBuild) {
  def scmVars
  if (prBuild) {
    scmVars = checkout([$class: 'GitSCM',
      branches: [
        [name: "${env.sha1}"]
      ],
      doGenerateSubmoduleConfigurations: false,
      extensions: [
        [$class: 'WipeWorkspace'],
        [$class: 'CheckoutOption', timeout: 30]
      ],
      submoduleCfg: [],
      userRemoteConfigs: [
        [credentialsId: 'xbuild-ml-frontend-gitenterprise-token',
          name: 'origin',
          refspec: "+refs/heads/*:refs/remotes/origin/* +refs/pull/*:refs/remotes/origin/pr/*",
          url: "${env.GITPROJECTURL}"
        ]
      ]
    ])

  } else {
    scmVars = checkout([$class: 'GitSCM',
      branches: [
        [name: "*/" + "${env.GITBRANCH}"]
      ],
      doGenerateSubmoduleConfigurations: false,
      extensions: [
        [$class: 'WipeWorkspace'],
        [$class: 'CheckoutOption', timeout: 30]
      ],
      submoduleCfg: [],
      userRemoteConfigs: [
        [credentialsId: 'xbuild-ml-frontend-gitenterprise-token',
          name: 'origin',
          url: "${env.GITPROJECTURL}"
        ]
      ]
    ])

  }

}

/*
 * Run Build @param Docker Container Name, run the buildXRT task in the docker container  
 */

def runBuild(docker_container_name) {
  return 'docker-compose run --rm ' + "${docker_container_name}" + ' "cd build/gradle; ./gradlew buildXRT --project-cache-dir=/tmp/' + "${docker_container_name}" + '"'
}

/*
 * Copy tar files generated by the build to a NFS location
 */

def copyTarFiles(releaseDir) {

  return '''
     fileList=`ls '''+"${env.WORKSPACE}"+'/build/'+"${releaseDir}"+'''/*.tar.gz`
     fileName="$(basename "$fileList")"
     folderName=$(echo $fileName | awk -F_ '{print $2}')
     release="'''+params.RELEASE+'''"
     releaseSplit=(` echo $release | tr '.' ' '`)
     size="${#releaseSplit[@]}"
     if [ $size -eq 2 ]
       then
          release="${release}.0"
     fi
     fullXRTFolderPath="'''+"${env.FILEPATHNFS}"+'''"${release}"/"${folderName}/'''+releaseDir+'''
     mkdir -p ${fullXRTFolderPath}
     cp '''+"${env.WORKSPACE}"+'''/build/'''+"${releaseDir}"+'''/*.tar.gz ${fullXRTFolderPath} 
         '''
}

/*
 * Publish Deb Packages @param Docker Container Name, run the publishDeb task in the docker container  
 */

def publishDeb(docker_container_name) {
  return 'docker-compose run --rm ' + "${docker_container_name}" + ' "cd build/gradle; ./gradlew publishDeb --project-cache-dir=/tmp/' + "${docker_container_name}" + '"'
}

/*
 * Publish RPM packages @param Docker Container Name, run the publishRPM task in the docker container  
 */

def publishRpm(docker_container_name) {
  return 'docker-compose run --rm ' + "${docker_container_name}" + ' "cd build/gradle; ./gradlew publishRpm --project-cache-dir=/tmp/' + "${docker_container_name}" + '"'
}

/*

Stages: 

1. Sync Workspace
2. Build XRT
3. Publish Packages
*/

node('AIEIPUPOOL') {

  try {

    stage('Sync Workspace') {
      syncWS(prBuild)
    }

    env.XDOCK_USER = sh(
      script: "id -u -n",
      returnStdout: true
    ).trim()

    env.XDOCK_UID = sh(
      script: "id -u ${USER}",
      returnStdout: true
    ).trim()

    env.XDOCK_GROUP =  sh(
      script: "id -g -n",
      returnStdout: true
    ).trim()

    env.XDOCK_GID = sh(
      script: "id -g ${USER}",
      returnStdout: true
    ).trim()

    timeout(time: 1, unit: 'HOURS') {

      Map buildStages = [: ]
      buildStages["Build Centos 76"] = {
        stage("Build Centos 76") {
            dir("${env.WORKSPACE}" + "/build/docker") {
              try {
                sh runBuild("xrt-ipu-centos76")
                if (params.BUILD_XLNX && !prBuild) {
                  sh copyTarFiles("Release_centos76")
                }
              } catch (all) {
                throw (all)
              }
            }
        }
      }
      buildStages["Build Ubuntu 2004"] = {
        stage("Build Ubuntu 2004") {
            dir("${env.WORKSPACE}" + "/build/docker") {
              try {
                sh runBuild("xrt-ipu-ubuntu1804")
                if (params.BUILD_XLNX && !prBuild) {
                  sh copyTarFiles("Release_ubuntu1804")

                }
              } catch (all) {
                throw (all)
              }
            }
        }
      }

      parallel(buildStages)

    }
    stage('Test') {
      timeout(time: 1, unit: 'HOURS') {
        echo "Running Tests"
      }
    }

    timeout(time: 1, unit: 'HOURS') {
      Map publishStages = [: ]

      publishStages["Publish Centos76"] = {
        stage("Publish Centos76") {
          if (prBuild || params.DEV) {
            echo "Skipping the Adding artifacts to Artifactory Step"
          } else {
            dir("${env.WORKSPACE}" + "/build/docker") {
              try {
                withCredentials([usernamePassword(credentialsId: env.AUTH_TOKEN, usernameVariable: 'USER', passwordVariable: 'AUTH_TOKEN')]) {
                  withEnv(["AUTH_TOKEN=${AUTH_TOKEN}", "USER=${USER}"]) {
                    sh publishRpm("xrt-ipu-centos76")
                  }
                }
              } catch (all) {
                throw (all)
              }
            }
          }
        }
      }

      publishStages["Publish Ubuntu2004"] = {
        stage("Publish Ubuntu2004") {
          if (prBuild || params.DEV) {
            echo "Skipping the Adding artifacts to Artifactory Step"
          } else {
            dir("${env.WORKSPACE}" + "/build/docker") {
              try {
                withCredentials([usernamePassword(credentialsId: env.AUTH_TOKEN, usernameVariable: 'USER', passwordVariable: 'AUTH_TOKEN')]) {
                  withEnv(["AUTH_TOKEN=${AUTH_TOKEN}", "USER=${USER}"]) {
                    sh publishDeb("xrt-ipu-ubuntu1804")
                  }
                }
              } catch (all) {
                throw (all)
              }
            }
          }
        }
      }
      parallel(publishStages)
    }
  } catch (all) {
    if (prBuild) {
      echo "Skipping Failure Email"
    } else {
      emailext body: 'Something is wrong with ${BUILD_URL}', to: params.EMAIL_RECIPIENTS, recipientProviders: [
        [$class: 'DevelopersRecipientProvider']
      ], subject: "Failed Pipeline: ${currentBuild.fullDisplayName}"
    }

    throw (all)
  } finally {
    echo "cleaning up ${env.WORKSPACE} on ${env.NODE_NAME}"
    cleanWs()

  }
}
