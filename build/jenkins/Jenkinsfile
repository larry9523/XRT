/**
These will be added to jenkinsfile as parameters and its default values once parameters are finalized.
Jenkins job parameters needed:
1. RELEASE (String) - Map to internal release Ex: 2021.2.0
2. GITPROJECTURL (String) - Git repo URL
3. GITBRANCH (String) - Git branch to build
4. DEV (Boolean) - DEV or PROD build
5. BUILD_XLNX (Boolean) - Whether the Build is run in Xilinx or non-xilinx env
6. AUTH_TOKEN (Credentials) - Username and password/access token for artifactory publishes
7. ARTIFACTORYSERVER (String) - Artifactory server url to publish packages
8. EMAIL_RECIPIENTS(String) - List of Email recipients
9. RPMREPOKEY(String) - RPM repo key in artifactory
10. WINREPOKEY (String) - Windows artifacts repo in artifactory
11. DEBREPOKEY(String) - Deb repo key in artifactory
12. XRT_IPU_NFS_LOC(String) - NFS Location for XRT
13. SIGNING_SERVICE_URL(String) - SIGNING_SERVICE_URL endpoint
*/

//Check if a PR Build or Not
boolean prBuild = env.ghprbPullLink != null;
runWindowsBuild = params.RUN_WIN_BUILD!=null?params.RUN_WIN_BUILD:true
env.AUTH_TOKEN = params.AUTH_TOKEN
env.DEBREPOKEY = params.DEBREPOKEY != null ? params.DEBREPOKEY : 'xrt-ipu-deb-prod-local'
env.RPMREPOKEY = params.RPMREPOKEY != null ? params.RPMREPOKEY : 'xrt-ipu-rpm-prod-local'
env.WINREPOKEY = params.WINREPOKEY != null ? params.WINREPOKEY : 'xrt-ipu-win-prod-local'
env.ARTIFACTORYSERVER = params.ARTIFACTORYSERVER != null ? params.ARTIFACTORYSERVER : 'https://xcoartifactory/artifactory'
env.FILEPATHNFS = params.XRT_IPU_NFS_LOC != null ? params.XRT_IPU_NFS_LOC : "/proj/xbuilds/XRT-IPU/"
env.NFSWORKSPACE = params.DEV ? '/proj/rdi-xco/buildsD/xbb/xrt-ipu' : '/proj/rdi-xco/builds/xbb/xrt-ipu'

// When Build is in XLNX and DEV is true
if (BUILD_XLNX && params.DEV) {
  FILEPATHNFS = "/proj/xbuilds/Dev/XRT-IPU/"
  env.DEBREPOKEY = 'xrt-ipu-deb-dev-local'
  env.RPMREPOKEY = 'xrt-ipu-rpm-dev-local'
  env.WINREPOKEY = 'xrt-ipu-win-dev-local'
}

/**
 * sync the git WS.
 * @param prBuild if true then it will get the PR to the sandbox, otherwise the commit
 * 
 */

def syncWS(boolean prBuild) {
  def scmVars
  if (prBuild) {
    scmVars = checkout([$class: 'GitSCM',
      branches: [
        [name: "${env.sha1}"]
      ],
      doGenerateSubmoduleConfigurations: false,
      extensions: [
        [$class: 'WipeWorkspace'],
        [$class: 'CheckoutOption', timeout: 30],
        [$class: 'RelativeTargetDirectory', relativeTargetDir: env.NFSWORKSPACE+"/"+"${BUILD_NUMBER}"]
      ],
      submoduleCfg: [],
      userRemoteConfigs: [
        [credentialsId: 'xbuild-ml-frontend-gitenterprise-token',
          name: 'origin',
          refspec: "+refs/heads/*:refs/remotes/origin/* +refs/pull/*:refs/remotes/origin/pr/*",
          url: "${env.GITPROJECTURL}"
        ]
      ]
    ])
  } else {
    scmVars = checkout([$class: 'GitSCM',
      branches: [
        [name: "*/" + "${env.GITBRANCH}"]
      ],
      doGenerateSubmoduleConfigurations: false,
      extensions: [
        [$class: 'WipeWorkspace'],
        [$class: 'CheckoutOption', timeout: 30],
        [$class: 'RelativeTargetDirectory', relativeTargetDir: env.NFSWORKSPACE+"/"+"${BUILD_NUMBER}"]
      ],
      submoduleCfg: [],
      userRemoteConfigs: [
        [credentialsId: 'xbuild-ml-frontend-gitenterprise-token',
          name: 'origin',
          url: "${env.GITPROJECTURL}"
        ]
      ]
    ])
  }
}

/**
 * Run Build @param Docker Container Name, run the buildXRT task in the docker container  
 */

def runBuild(docker_container_name) {
  return 'docker-compose run --rm ' + "${docker_container_name}" + ' "cd build/gradle; ./gradlew buildXRT --project-cache-dir=/tmp/' + "${docker_container_name}" + '"'
}

/**
 * Extract Files to NFS location
 */

def extractTarFiles(releaseDir, os){

  return '''
     fileList=`ls '''+"${env.NFSWORKSPACE}"+"/"+"${BUILD_NUMBER}"+'/build/'+"${releaseDir}"+'''/*.tar.gz`
     fileName="$(basename "$fileList")"
     release="'''+params.RELEASE+'''"
     releaseSplit=(` echo $release | tr '.' ' '`)
     size="${#releaseSplit[@]}"
     if [ $size -eq 2 ]
       then
          release="${release}.0"
     fi
     folderName=${release}.'''+"${BUILD_NUMBER}"+'''
     tarFilesPath="'''+"${env.NFSWORKSPACE}"+"/"+"${BUILD_NUMBER}"+'''/build/'''+"${releaseDir}"+'''"
     cp '''+"${env.NFSWORKSPACE}"+"/"+"${BUILD_NUMBER}"+'''/build/settings.sh '''+"${env.FILEPATHNFS}"+'''"${release}"/"${folderName}"
     extractedFolderPath="'''+"${env.FILEPATHNFS}"+'''"${release}"/"${folderName}/x86_64/'''+os+'''-default
     mkdir -p ${extractedFolderPath}
     for f in ${tarFilesPath}/*.tar.gz; do tar -xvf "$f" -C ${extractedFolderPath}; done
         '''


}

/**
  Copy tar files generated by the build to a NFS location
 */

def copyTarFiles(releaseDir) {

  return '''
     fileList=`ls '''+"${env.NFSWORKSPACE}"+"/"+"${BUILD_NUMBER}"+'/build/'+"${releaseDir}"+'''/*.tar.gz`
     fileName="$(basename "$fileList")"
     release="'''+params.RELEASE+'''"
     releaseSplit=(` echo $release | tr '.' ' '`)
     size="${#releaseSplit[@]}"
     if [ $size -eq 2 ]
       then
          release="${release}.0"
     fi
     folderName=${release}.'''+"${BUILD_NUMBER}"+'''
     fullXRTFolderPath="'''+"${env.FILEPATHNFS}"+'''"${release}"/"${folderName}/'''+releaseDir+'''
     mkdir -p ${fullXRTFolderPath}
     cp '''+"${env.NFSWORKSPACE}"+"/"+"${BUILD_NUMBER}"+'''/build/'''+"${releaseDir}"+'''/*.tar.gz ${fullXRTFolderPath}
         '''
}

/**
 * Publish Deb Packages @param Docker Container Name, run the publishDeb task in the docker container  
 */

def publishDeb(docker_container_name) {
  return 'docker-compose run --rm ' + "${docker_container_name}" + ' "cd build/gradle; ./gradlew publishDeb --project-cache-dir=/tmp/' + "${docker_container_name}" + '"'
}

/**
 * Publish RPM packages @param Docker Container Name, run the publishRPM task in the docker container  
 */

def publishRpm(docker_container_name) {
  return 'docker-compose run --rm ' + "${docker_container_name}" + ' "cd build/gradle; ./gradlew publishRpm --project-cache-dir=/tmp/' + "${docker_container_name}" + '"'
}

/**
 * Publish artifacts and manifest file to artifactory
 *  @param BUILD_XLNX needed for artifactory ssl communication
 */
def publishWin(BUILD_XLNX, docker_container_name) {
    if (BUILD_XLNX) {
        return 'docker-compose run --rm ${docker_container_name} "cd gradle && ./gradlew artifactoryPublish --project-cache-dir=/tmp/${docker_container_name}_win -Djavax.net.ssl.trustStore=/proj/xbuilds/certs/cacerts"'
    } else {
        return 'docker-compose run --rm ${docker_container_name} "cd gradle && ./gradlew artifactoryPublish --project-cache-dir=/tmp/${docker_container_name}_win"' 
    }
}

/**
 * Run Build from windows VM
 */

def buildPackageWinVM(){
  splitPath = env.NFSWORKSPACE.tokenize('/')
  drive = "R:"
  windowsPath = drive
  splitPath.eachWithIndex { dir, i ->
      if(i>1){
        windowsPath = windowsPath + "\\\""+"${dir}"+"\""
      }
  };
  windowsPath = windowsPath + "\\\"${BUILD_NUMBER}\""+ "\\\"build\""
  return drive + " & cd "+ windowsPath +" & C:\\\"Program Files (x86)\"\\\"Microsoft Visual Studio\"\\2017\\Community\\VC\\Auxiliary\\Build\\vcvars64.bat & build.bat -release -package"
}

/**
 * Copy .exe and .zip files generated by Windows build
 */

def copyWinFiles(releaseDir){

  return '''
     fileList=(`find  '''+"${env.NFSWORKSPACE}"+"/"+"${BUILD_NUMBER}"+'''/build/WRelease/_CPack_Packages/win64 -type f \\( -name "*.exe" -o -name "*.msi" \\) | sort -r`)
     fileName="${fileList[0]}"
     dirName=$(echo ${fileName} | awk '{n=split($1,A,"/"); print A[n-4]}')
     release="'''+params.RELEASE+'''"
     releaseSplit=(` echo $release | tr '.' ' '`)
     size="${#releaseSplit[@]}"
     if [ $size -eq 2 ]
       then
          release="${release}.0"
     fi
     folderName=$(echo ${release}.'''+"${BUILD_NUMBER}"+''')
     winRelFolderPath="'''+"${env.FILEPATHNFS}"+'''"${release}"/"${folderName}/'''+releaseDir+'''
     mkdir -p ${winRelFolderPath}
     find '''+"${env.NFSWORKSPACE}"+"/"+"${BUILD_NUMBER}"+'''/build/WRelease/_CPack_Packages/win64/WIX  -type f \\( -name "*.exe" -o -name "*.msi" \\) -exec cp '{}' ${winRelFolderPath} \\;
     cp '''+"${env.NFSWORKSPACE}"+"/"+"${BUILD_NUMBER}"+'''/build/WRelease/XRT_*-amd64.zip ${winRelFolderPath}
         '''

}


/**
 * Sign windows packages
 */
def signWinPackages(signing_service_url, path) {
  def files_tobe_signed = sh(script: """ cd ${path}; find * -type f -name "*.exe" -o -name "*.cat" -o -name "*.msi" -o -name "*.sys" | grep -v "/test/" """, returnStdout: true)
  List<String> list_files = files_tobe_signed.trim().tokenize('\n')
  List<String> path_split = path.tokenize('/')
  path_split.removeAt(0)
  if (path_split[0].equalsIgnoreCase('rdi') || path_split[0].equalsIgnoreCase('rdi-xco')) {
    path_split.removeAt(0)
  }
  String path_joined = path_split.join('/')
  list_files.each { executable ->
    sh """curl -v --fail --max-time 120 -o /dev/null --silent --head --write-out '%{http_code}\n'  ${signing_service_url}/${path_joined}/${executable}"""
  }
} 

/**

Stages: 

1. Sync Workspace
2. Build XRT
3. Publish Packages
*/

node('xcoIPULinPool') {

  try {

    stage('Sync Workspace') {
      syncWS(prBuild)
    }

    env.XDOCK_USER = sh(
      script: "id -u -n",
      returnStdout: true
    ).trim()

    env.XDOCK_UID = sh(
      script: "id -u ${USER}",
      returnStdout: true
    ).trim()

    env.XDOCK_GROUP =  sh(
      script: "id -g -n",
      returnStdout: true
    ).trim()

    env.XDOCK_GID = sh(
      script: "id -g ${USER}",
      returnStdout: true
    ).trim()

    timeout(time: 1, unit: 'HOURS') {

      Map buildStages = [:]
      buildStages["Build Centos 76"] = {
        stage("Build Centos 76") {
            dir("${env.NFSWORKSPACE}"+"/"+"${BUILD_NUMBER}" + "/build/docker") {
              try {
                sh runBuild("xrt-ipu-centos76")
                if (params.BUILD_XLNX && !prBuild) {
                  sh copyTarFiles("Release_centos76")
                }
                if (!prBuild){
                  sh extractTarFiles("Release_centos76", "centos")
                }
              } catch (all) {
                throw (all)
              }
            }
        }
      }
      buildStages["Build Ubuntu 1804"] = {
        stage("Build Ubuntu 1804") {
            dir("${env.NFSWORKSPACE}"+"/"+"${BUILD_NUMBER}" + "/build/docker") {
              try {
                sh runBuild("xrt-ipu-ubuntu1804")
                if (params.BUILD_XLNX && !prBuild) {
                  sh copyTarFiles("Release_ubuntu1804")

                }
                if (!prBuild){
                  sh extractTarFiles("Release_ubuntu1804", "ubuntu")
                }
              } catch (all) {
                throw (all)
              }
            }
        }
      }

      if (params.BUILD_XLNX && runWindowsBuild) {
        buildStages["Build Windows"] = {
          stage("Build on Windows") {
            try {
              node("xcoIPUWinPool") {
                withEnv(["XRT_VERSION_PATCH=${BUILD_NUMBER}", "MSVC_PARALLEL_JOBS=6"]){
                  bat buildPackageWinVM()
                }
              }
              if (params.BUILD_XLNX && !prBuild) {
                sh copyWinFiles("WRelease")
                if (params.SIGNING_SERVICE_URL) {
                  stage("Sign artifacts") {
                    signWinPackages(params.SIGNING_SERVICE_URL, "${env.NFSWORKSPACE}"+"/"+"${BUILD_NUMBER}"+"/build/WRelease/_CPack_Packages/win64/")
                  }
                }
              }
            } catch(all) {
              throw(all)
            }
          }
        }
      }
      parallel(buildStages)
    }

    stage('Test') {
      timeout(time: 1, unit: 'HOURS') {
        echo "Running Tests"
      }
    }

    timeout(time: 1, unit: 'HOURS') {
      Map publishStages = [: ]

      publishStages["Publish Centos76"] = {
        stage("Publish Centos76") {
          if (prBuild || params.DEV) {
            echo "Skipping the Adding artifacts to Artifactory Step"
          } else {
            dir("${env.NFSWORKSPACE}"+"/"+"${BUILD_NUMBER}" + "/build/docker") {
              try {
                withCredentials([usernamePassword(credentialsId: env.AUTH_TOKEN, usernameVariable: 'USER', passwordVariable: 'AUTH_TOKEN')]) {
                  withEnv(["AUTH_TOKEN=${AUTH_TOKEN}", "USER=${USER}"]) {
                    sh publishRpm("xrt-ipu-centos76")
                  }
                }
              } catch (all) {
                throw (all)
              }
            }
          }
        }
      }

      publishStages["Publish Ubuntu1804"] = {
        stage("Publish Ubuntu1804") {
          if (prBuild || params.DEV) {
            echo "Skipping the Adding artifacts to Artifactory Step"
          } else {
            dir("${env.NFSWORKSPACE}"+"/"+"${BUILD_NUMBER}" + "/build/docker") {
              try {
                withCredentials([usernamePassword(credentialsId: env.AUTH_TOKEN, usernameVariable: 'USER', passwordVariable: 'AUTH_TOKEN')]) {
                  withEnv(["AUTH_TOKEN=${AUTH_TOKEN}", "USER=${USER}"]) {
                    sh publishDeb("xrt-ipu-ubuntu1804")
                  }
                }
              } catch (all) {
                throw (all)
              }
            }
          }
        }
      }

      publishStages["Publish_Windows"] = {
        stage("Publish_Win10") {
          if (prBuild) {
            echo "Skipping the Adding artifacts to Artifactory Step"
          } else {
            dir("${env.NFSWORKSPACE}"+"/"+"${BUILD_NUMBER}" + "/build/docker") {
              try {
                withCredentials([usernamePassword(credentialsId: env.AUTH_TOKEN, usernameVariable: 'USER', passwordVariable: 'AUTH_TOKEN')]) {
                  withEnv(["AUTH_TOKEN=${AUTH_TOKEN}", "USER=${USER}"]) {
                    sh publishWin(BUILD_XLNX,"xrt-ipu-centos76")
                  }
                }
              } catch (all) {
                throw (all)
              }
            }
          }
        }
      }
      parallel(publishStages)
    }
  } catch (all) {
    if (prBuild) {
      echo "Skipping Failure Email"
    } else {
      emailext body: 'Something is wrong with ${BUILD_URL}', to: params.EMAIL_RECIPIENTS, recipientProviders: [
        [$class: 'DevelopersRecipientProvider']
      ], subject: "Failed Pipeline: ${currentBuild.fullDisplayName}"
    }

    throw (all)
  } finally {
    echo "cleaning up ${env.NFSWORKSPACE} on ${env.NODE_NAME}"
    cleanWs()
    dir(env.NFSWORKSPACE+"/"+"${BUILD_NUMBER}"){
       deleteDir()
   }
  }
}
